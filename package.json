{
  "name": "qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin for hybrid QA: Playwright MCP exploration + Playwright Test regression + AI result analysis.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"tests/unit/**/*.test.ts\" \"tests/contract/**/*.test.ts\"",
    "test:integration": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "smoke:mcp": "node scripts/smoke/mcp-smoke.mjs",
    "smoke:claude": "node scripts/smoke/claude-plugin-smoke.mjs",
    "smoke:claude-hook": "node scripts/smoke/claude-hook-smoke.mjs",
    "bench": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench/benchmark.mjs",
    "qa": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "progress": "node scripts/progress.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
